programa {
  funcao inicio() {
   //entendimento
   //ler a quantidade de pessoas e calcular a aquantidade de produtos para comprar
   //infos e variáveis
   inteiro pessoas 
   real carne, cerveja, agua, refri,
   //entrada de dados
   escreva("quantas de pessoas: ")
   leia(pessoas)
   //processamento
   carne = pessoas * 0.5
   cerveja = pessoas * 1
   refri = pessoas * 0.2
  
   //saida
   escreva("\Ncarne: " + carne)
   escreva("\Ncerveja: " + agua)
   escreva("\nrefri: " refri)
  }
}
